# Copy this file to .env before running Docker Compose.
# Keep real secrets in .env only; do not commit real Stripe keys.

STRIPE_SECRET_KEY=sk_test_replace_me

# External provider API access. The compose file has a demo default, but setting
# this explicitly is clearer when deploying.
# Optional: set a provider API key here if you do not want to use the compose default.
# INTEGRATION_DEFAULT_API_KEY=sk_saas_replace_me
INTEGRATION_USE_MOCK=false
MESSAGING_ENABLED=true

# Local defaults. Change PUBLIC_HOST and ports for server deployments.
PUBLIC_HOST=localhost
WEB_PORT=3000
API_GATEWAY_PORT=8080
MONITOR_PORT=9090
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
